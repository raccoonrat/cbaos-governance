################################################################################
# CBA-OS .gitignore baseline (governance-first / docs-heavy)
# - Protect repo from OS/editor noise
# - Reduce risk of committing local env/secrets
# - Keep LaTeX rules below (some teams export PDFs)
################################################################################

# --- OS / filesystem noise ---
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.Spotlight-V100/
.Trashes/
._*

# --- Editor / IDE ---
.vscode/
.idea/
*.iml
*.swp
*.swo
*~

# --- Python ---
__pycache__/
*.py[cod]
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.venv/
venv/
env/

# --- Node / JS tooling ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Build / temp / cache ---
dist/
build/
tmp/
temp/
.cache/
*.bak
*.orig

# --- Logs ---
*.log
logs/
*.out
*.err

# --- Archives / packages ---
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# --- Local environment / secrets / configs ---
# IMPORTANT: keep secrets and local environment files out of version control
.env
.env.*
*.local
*.secret
*.secrets
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Sensitive config candidates (keep local-only unless explicitly governed)
config.local.*
settings.local.*
credentials.*
secrets.*
private.*

# Generated evidence / runtime outputs (store governed artifacts elsewhere)
artifacts/tmp/
artifacts/local/
evidence/local/
reports/tmp/
reports/local/
release/tmp/

# --- Jupyter / notebooks (if used locally) ---
.ipynb_checkpoints/

# --- Terraform / infra (optional protection) ---
.terraform/
*.tfstate
*.tfstate.*
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# --- GitHub Actions local test leftovers ---
act-cache/
.actrc.local

# --- Shell history / accidental drops ---
.history
*.history

## Core latex/pdflatex auxiliary files:
*.aux
*.lof
*.log
*.lot
*.fls
*.out
*.toc
*.fmt
*.fot
*.cb
*.cb2
.*.lb

## Intermediate documents:
*.dvi
*.xdv
*-converted-to.*
# these rules might exclude image files for figures etc.
# *.ps
# *.eps
# *.pdf

## Generated if empty string is given at "Please type another file name for output:"
.pdf

## Bibliography auxiliary files (bibtex/biblatex/biber):
*.bbl
*.bbl-SAVE-ERROR
*.bcf
*.bcf-SAVE-ERROR
*.blg
*-blx.aux
*-blx.bib
*.run.xml

## Build tool auxiliary files:
*.fdb_latexmk
*.synctex
*.synctex(busy)
*.synctex.gz
*.synctex.gz(busy)
*.pdfsync
*.rubbercache
rubber.cache

## Build tool directories for auxiliary files
# latexrun
latex.out/

